# Rendered into the agent's env file by the deploy workflow from repo variables and secrets.
# Never commit real values.

# Required (deploy/provision.sh sets these as repo variables)
PVE_NODES=pve1=192.0.2.11,pve2=192.0.2.12,pve3=192.0.2.13
DOCKER_HOSTS=docker1=192.0.2.21,docker2=192.0.2.22
SELF_GUEST=100

# Secrets
#NOTIFY_URLS=https://discord.com/api/webhooks/<id>/<token>
#AGENT_BUS_TOKEN=<openssl rand -hex 32>
#APPROVAL_NOTIFY_URLS=https://discord.com/api/webhooks/<id>/<token>

# Schedule (local time in TIMEZONE)
#TIMEZONE=America/New_York
#CHECK_TIME=07:00
#WINDOW_DAY=sun
#WINDOW_TIME=03:00
#WINDOW_HOURS=3

# Maintenance window
#REBOOT_GUESTS=true
#REBOOT_NODES=true
#REDEPLOY=true
#KEEP_SNAPSHOTS=false
#SNAPSHOT_KEEP=2
#EXCLUDE_GUESTS=

# Health
#CPU_PERCENT=80
#MEM_PERCENT=80
#SUSTAIN_MINUTES=15
#MONITOR_SECONDS=60
#DISK_PERCENT=85
#DISK_TARGET_PERCENT=70
#GROW_MIN_GB=5
#GROW_MAX_GB=50
#STORAGE_MAX_PERCENT=90
#DISK_MINUTES=15

# Notifications and agent bus
#RENOTIFY_HOURS=24
#AGENT_BUS_PORT=8765
#APPROVAL_MODE=client
#BOT_ALERT_URL=
