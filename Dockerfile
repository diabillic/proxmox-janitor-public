# Don't edit by hand: it's regenerated whenever those files change. Change them instead.
#
# Build: docker build --pull --build-arg PATCHED_AT=$(date +%s) --build-arg REVISION=$(git rev-parse HEAD) -t proxmox-janitor .
# Run:   docker run -d --name proxmox-janitor --restart unless-stopped \
#     --env-file agent.env \
#     -v proxmox-janitor-data:/var/lib/proxmox-janitor \
#     -p 8765:8765 \
#     proxmox-janitor
#
# agent.env holds the settings in .env.example (the deploy workflow renders it from repo variables and secrets).

FROM python:3.13-slim-trixie

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
ENV TZ=America/New_York

ARG DEBIAN_FRONTEND=noninteractive
ARG PATCHED_AT=unknown
RUN echo "Patching the base OS ($PATCHED_AT)" \
 && apt-get update \
 && apt-get -y full-upgrade \
 && apt-get install -y --no-install-recommends ca-certificates openssh-client tzdata \
 && ln -snf "/usr/share/zoneinfo/$TZ" /etc/localtime && echo "$TZ" > /etc/timezone \
 && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN groupadd --system proxmox-janitor \
 && useradd --system --gid proxmox-janitor --home-dir /var/lib/proxmox-janitor --shell /usr/sbin/nologin proxmox-janitor \
 && install -d -o proxmox-janitor -g proxmox-janitor /var/lib/proxmox-janitor

WORKDIR /opt/proxmox-janitor/app
COPY requirements.txt ./
RUN pip install -r requirements.txt
COPY proxmox_janitor/ ./proxmox_janitor/
ARG REVISION=unknown
RUN echo "$REVISION" > REVISION

ENV STATE_PATH=/var/lib/proxmox-janitor/state.json
USER proxmox-janitor
VOLUME ["/var/lib/proxmox-janitor"]
EXPOSE 8765
HEALTHCHECK --interval=60s --timeout=15s --start-period=2m --retries=3 \
  CMD ["python", "-m", "proxmox_janitor.health"]
CMD ["python", "-m", "proxmox_janitor"]
